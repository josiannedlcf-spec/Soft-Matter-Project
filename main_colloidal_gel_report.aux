\@writefile{toc}{\contentsline {section}{\numberline {8}Results: Particle Configurations}{7}{section.8}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Particle configurations for the gel ($\varepsilon =5k_BT$) at $t=0$, $20$, $40$ and $60\tau $. Small clusters begin to form between $t=0$ and $t=60\tau $, but a fully percolated network is not yet established within this simulation window.}}{8}{figure.caption.3}\protected@file@percent }
\newlabel{fig:gel_configurations}{{1}{8}{Particle configurations for the gel ($\varepsilon =5k_BT$) at $t=0$, $20$, $40$ and $60\tau $. Small clusters begin to form between $t=0$ and $t=60\tau $, but a fully percolated network is not yet established within this simulation window}{figure.caption.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Particle configurations for the liquid reference ($\varepsilon =1.5k_BT$) at $t=0$, $20$, $40$ and $60\tau $. Clustering is visible but more transient than in the gel; the system remains spatially more homogeneous throughout the simulation.}}{8}{figure.caption.4}\protected@file@percent }
\newlabel{fig:liquid_configurations}{{2}{8}{Particle configurations for the liquid reference ($\varepsilon =1.5k_BT$) at $t=0$, $20$, $40$ and $60\tau $. Clustering is visible but more transient than in the gel; the system remains spatially more homogeneous throughout the simulation}{figure.caption.4}{}}
\@writefile{toc}{\contentsline {section}{\numberline {9}Results: Structure Factor Analysis}{8}{section.9}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {9.1}$S(k,t)$ Evolution}{8}{subsection.9.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces $S(k,t)$ evolution for the gel ($\varepsilon =5k_BT$). A peak forms around $k^*\simeq 2.5\sigma ^{-1}$ and remains stable over $200\tau $, indicating incipient kinetic arrest.}}{9}{figure.caption.5}\protected@file@percent }
\newlabel{fig:sk_gel}{{3}{9}{$S(k,t)$ evolution for the gel ($\varepsilon =5k_BT$). A peak forms around $k^*\simeq 2.5\sigma ^{-1}$ and remains stable over $200\tau $, indicating incipient kinetic arrest}{figure.caption.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces $S(k,t)$ evolution for the liquid reference ($\varepsilon =1.5k_BT$). The peak amplitude grows continuously and the peak position drifts towards lower $k$ over time, consistent with ongoing diffusive coarsening without arrest.}}{9}{figure.caption.6}\protected@file@percent }
\newlabel{fig:sk_liquid}{{4}{9}{$S(k,t)$ evolution for the liquid reference ($\varepsilon =1.5k_BT$). The peak amplitude grows continuously and the peak position drifts towards lower $k$ over time, consistent with ongoing diffusive coarsening without arrest}{figure.caption.6}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {9.2}Final Structure Factor: Gel versus Liquid}{9}{subsection.9.2}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {9.3}Peak Wavevector $k^*(t)$}{9}{subsection.9.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Final structure factor $S(k)$ at $t=200\tau $ for the gel and liquid reference. The liquid has a higher peak amplitude, explained by its ergodic continuous coarsening. The gel shows a stable, lower peak consistent with incipient arrest.}}{10}{figure.caption.7}\protected@file@percent }
\newlabel{fig:final_sk}{{5}{10}{Final structure factor $S(k)$ at $t=200\tau $ for the gel and liquid reference. The liquid has a higher peak amplitude, explained by its ergodic continuous coarsening. The gel shows a stable, lower peak consistent with incipient arrest}{figure.caption.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Peak wavevector $k^*(t)$ as a function of time. The gel plateaus around $k^*\simeq 2.5\sigma ^{-1}$ after $t\simeq 40\tau $, indicating a frozen characteristic domain size. The liquid shows a systematic decrease consistent with diffusive coarsening.}}{10}{figure.caption.8}\protected@file@percent }
\newlabel{fig:kstar}{{6}{10}{Peak wavevector $k^*(t)$ as a function of time. The gel plateaus around $k^*\simeq 2.5\sigma ^{-1}$ after $t\simeq 40\tau $, indicating a frozen characteristic domain size. The liquid shows a systematic decrease consistent with diffusive coarsening}{figure.caption.8}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {9.4}Peak Amplitude $S(k^*,t)$}{10}{subsection.9.4}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {9.5}Final Particle Configurations: Gel versus Liquid}{10}{subsection.9.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Peak structure-factor amplitude $S(k^*,t)$ as a function of time. The liquid grows continuously, while the gel saturates, consistent with kinetic arrest halting domain growth.}}{11}{figure.caption.9}\protected@file@percent }
\newlabel{fig:smax}{{7}{11}{Peak structure-factor amplitude $S(k^*,t)$ as a function of time. The liquid grows continuously, while the gel saturates, consistent with kinetic arrest halting domain growth}{figure.caption.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Final particle configurations at $t=200\tau $ for the gel and liquid reference. The gel shows small frozen clusters; the liquid shows more compact, larger clusters from continued coarsening.}}{11}{figure.caption.10}\protected@file@percent }
\newlabel{fig:final_configs}{{8}{11}{Final particle configurations at $t=200\tau $ for the gel and liquid reference. The gel shows small frozen clusters; the liquid shows more compact, larger clusters from continued coarsening}{figure.caption.10}{}}
\@writefile{toc}{\contentsline {section}{\numberline {10}Results: MSD and Ageing Analysis}{11}{section.10}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {10.1}MSD of the Gel}{11}{subsection.10.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces $\mathrm  {MSD}(\Delta t,t_w)$ for the gel ($\varepsilon =5k_BT$). All curves fall below free diffusion. Sub-diffusive behaviour is visible at intermediate lag times. The spread between $t_w$ curves is marginal, indicating incomplete arrest.}}{12}{figure.caption.11}\protected@file@percent }
\newlabel{fig:msd_gel}{{9}{12}{$\mathrm {MSD}(\Delta t,t_w)$ for the gel ($\varepsilon =5k_BT$). All curves fall below free diffusion. Sub-diffusive behaviour is visible at intermediate lag times. The spread between $t_w$ curves is marginal, indicating incomplete arrest}{figure.caption.11}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {10.2}MSD of the Liquid Reference}{12}{subsection.10.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces $\mathrm  {MSD}(\Delta t,t_w)$ for the liquid reference ($\varepsilon =1.5k_BT$). The approximate collapse of the later waiting-time curves is consistent with ergodic behaviour.}}{12}{figure.caption.12}\protected@file@percent }
\newlabel{fig:msd_liquid}{{10}{12}{$\mathrm {MSD}(\Delta t,t_w)$ for the liquid reference ($\varepsilon =1.5k_BT$). The approximate collapse of the later waiting-time curves is consistent with ergodic behaviour}{figure.caption.12}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {10.3}Ageing Comparison: Gel versus Liquid}{13}{subsection.10.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces MSD ageing comparison in log-log scale: gel versus liquid reference. Both show sub-diffusive behaviour below free diffusion. The gel shows slightly less curve collapse than the liquid, consistent with incipient non-ergodicity, but a conclusive ageing signal requires longer simulation times.}}{13}{figure.caption.13}\protected@file@percent }
\newlabel{fig:ageing_comparison}{{11}{13}{MSD ageing comparison in log-log scale: gel versus liquid reference. Both show sub-diffusive behaviour below free diffusion. The gel shows slightly less curve collapse than the liquid, consistent with incipient non-ergodicity, but a conclusive ageing signal requires longer simulation times}{figure.caption.13}{}}
