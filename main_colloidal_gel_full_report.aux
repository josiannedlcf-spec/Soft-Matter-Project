\@writefile{toc}{\contentsline {section}{\numberline {8}Results: Particle Configurations}{9}{section.8}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Particle configurations for the gel ($\varepsilon =5k_BT$) at $t=0$, $20$, $40$ and $60\tau $. Small clusters begin to form, but a fully percolated network is not yet established within this simulation window.}}{10}{figure.caption.3}\protected@file@percent }
\newlabel{fig:positions_gel}{{1}{10}{Particle configurations for the gel ($\varepsilon =5k_BT$) at $t=0$, $20$, $40$ and $60\tau $. Small clusters begin to form, but a fully percolated network is not yet established within this simulation window}{figure.caption.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Particle configurations for the liquid reference ($\varepsilon =1.5k_BT$) at $t=0$, $20$, $40$ and $60\tau $. Clustering is visible but more transient than in the gel; the system remains spatially more homogeneous throughout the simulation.}}{10}{figure.caption.4}\protected@file@percent }
\newlabel{fig:positions_liquid}{{2}{10}{Particle configurations for the liquid reference ($\varepsilon =1.5k_BT$) at $t=0$, $20$, $40$ and $60\tau $. Clustering is visible but more transient than in the gel; the system remains spatially more homogeneous throughout the simulation}{figure.caption.4}{}}
\@writefile{toc}{\contentsline {section}{\numberline {9}Results: Structure Factor Analysis}{10}{section.9}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {9.1}$S(k,t)$ Evolution}{10}{subsection.9.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Time evolution of $S(k,t)$ for the gel ($\varepsilon =5k_BT$). A peak forms around $k^*\simeq 2.5\,\sigma ^{-1}$ and remains approximately stable in position. Circles mark the peak position $k^*$ at each snapshot.}}{11}{figure.caption.5}\protected@file@percent }
\newlabel{fig:sk_gel}{{3}{11}{Time evolution of $S(k,t)$ for the gel ($\varepsilon =5k_BT$). A peak forms around $k^*\simeq 2.5\,\sigma ^{-1}$ and remains approximately stable in position. Circles mark the peak position $k^*$ at each snapshot}{figure.caption.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Time evolution of $S(k,t)$ for the liquid reference ($\varepsilon =1.5k_BT$). The peak amplitude grows and the peak position tends to drift towards lower $k$, consistent with ongoing coarsening without complete arrest.}}{12}{figure.caption.6}\protected@file@percent }
\newlabel{fig:sk_liquid}{{4}{12}{Time evolution of $S(k,t)$ for the liquid reference ($\varepsilon =1.5k_BT$). The peak amplitude grows and the peak position tends to drift towards lower $k$, consistent with ongoing coarsening without complete arrest}{figure.caption.6}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {9.2}Final Structure Factor: Gel vs Liquid}{12}{subsection.9.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Final structure factor $S(k)$ at $t=200\tau $ for the gel and the liquid reference. The liquid has a higher peak amplitude, reflecting continued coarsening. The gel shows a lower but more stable peak consistent with incipient arrest.}}{13}{figure.caption.7}\protected@file@percent }
\newlabel{fig:sk_final}{{5}{13}{Final structure factor $S(k)$ at $t=200\tau $ for the gel and the liquid reference. The liquid has a higher peak amplitude, reflecting continued coarsening. The gel shows a lower but more stable peak consistent with incipient arrest}{figure.caption.7}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {9.3}Peak Wavevector $k^*(t)$}{13}{subsection.9.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Peak wavevector $k^*(t)$ as a function of time. The gel plateaus around $k^*\simeq 2.5\,\sigma ^{-1}$, indicating a nearly frozen characteristic domain size. The liquid tends to shift towards lower $k$, consistent with diffusive coarsening.}}{14}{figure.caption.8}\protected@file@percent }
\newlabel{fig:kstar}{{6}{14}{Peak wavevector $k^*(t)$ as a function of time. The gel plateaus around $k^*\simeq 2.5\,\sigma ^{-1}$, indicating a nearly frozen characteristic domain size. The liquid tends to shift towards lower $k$, consistent with diffusive coarsening}{figure.caption.8}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {9.4}Peak Amplitude $S(k^*,t)$}{14}{subsection.9.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Peak structure-factor amplitude $S(k^*,t)$ as a function of time. The liquid grows continuously to larger values, while the gel saturates around a lower value, consistent with the slowing down of structural evolution.}}{15}{figure.caption.9}\protected@file@percent }
\newlabel{fig:sstar}{{7}{15}{Peak structure-factor amplitude $S(k^*,t)$ as a function of time. The liquid grows continuously to larger values, while the gel saturates around a lower value, consistent with the slowing down of structural evolution}{figure.caption.9}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {9.5}Final Particle Configurations: Gel vs Liquid}{15}{subsection.9.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Final particle configurations at $t=200\tau $ for the gel and the liquid reference. The gel shows small frozen clusters, while the liquid shows more compact clusters due to continued coarsening.}}{16}{figure.caption.10}\protected@file@percent }
\newlabel{fig:final_positions}{{8}{16}{Final particle configurations at $t=200\tau $ for the gel and the liquid reference. The gel shows small frozen clusters, while the liquid shows more compact clusters due to continued coarsening}{figure.caption.10}{}}
\@writefile{toc}{\contentsline {section}{\numberline {10}Results: MSD and Ageing Analysis}{16}{section.10}\protected@file@percent }
\newlabel{sec:msd_ageing}{{10}{16}{Results: MSD and Ageing Analysis}{section.10}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {10.1}MSD of the Gel}{16}{subsection.10.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces MSD$(\Delta t,t_w)$ for the gel ($\varepsilon =5k_BT$) in linear and log--log scales. All curves fall below free diffusion. The spread between $t_w$ curves is marginal, indicating incomplete arrest.}}{17}{figure.caption.11}\protected@file@percent }
\newlabel{fig:msd_gel}{{9}{17}{MSD$(\Delta t,t_w)$ for the gel ($\varepsilon =5k_BT$) in linear and log--log scales. All curves fall below free diffusion. The spread between $t_w$ curves is marginal, indicating incomplete arrest}{figure.caption.11}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {10.2}MSD of the Liquid Reference}{17}{subsection.10.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces MSD$(\Delta t,t_w)$ for the liquid reference ($\varepsilon =1.5k_BT$) in linear and log--log scales. The approximate collapse of later waiting-time curves is consistent with ergodic behaviour.}}{17}{figure.caption.12}\protected@file@percent }
\newlabel{fig:msd_liquid}{{10}{17}{MSD$(\Delta t,t_w)$ for the liquid reference ($\varepsilon =1.5k_BT$) in linear and log--log scales. The approximate collapse of later waiting-time curves is consistent with ergodic behaviour}{figure.caption.12}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {10.3}Ageing Comparison: Gel vs Liquid}{17}{subsection.10.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces MSD ageing comparison in log--log scale: gel versus liquid reference. The gel shows slightly less collapse than the liquid, consistent with incipient non-ergodicity, but a conclusive ageing signal requires longer simulations or stronger attractions.}}{18}{figure.caption.13}\protected@file@percent }
\newlabel{fig:ageing_comparison}{{11}{18}{MSD ageing comparison in log--log scale: gel versus liquid reference. The gel shows slightly less collapse than the liquid, consistent with incipient non-ergodicity, but a conclusive ageing signal requires longer simulations or stronger attractions}{figure.caption.13}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces MSD at fixed lag time $\Delta t\simeq 20\tau $ as a function of waiting time $t_w$. A clear decrease in the gel would indicate ageing, but the present data show only a weak or ambiguous signal.}}{18}{figure.caption.14}\protected@file@percent }
\newlabel{fig:msd_tw}{{12}{18}{MSD at fixed lag time $\Delta t\simeq 20\tau $ as a function of waiting time $t_w$. A clear decrease in the gel would indicate ageing, but the present data show only a weak or ambiguous signal}{figure.caption.14}{}}
